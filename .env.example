# Embedding API key (required)
# Jina: https://jina.ai/ — get a free API key
JINA_API_KEY=your_jina_api_key_here

# Reranker API key (optional)
# retrieval.rerank defaults to "cross-encoder", but without a key the pipeline
# silently falls back to cosine similarity. Set this and reference it from
# config.json as "rerankApiKey": "${RECALLNEST_RERANK_API_KEY}" to enable it.
# A Jina key works as-is (default model jina-reranker-v3 @ api.jina.ai).
# RECALLNEST_RERANK_API_KEY=your_reranker_api_key_here

# ── Feature flags (all optional, all default off) ────────────────────────────
# Each flag is compared against the exact lowercase string "true".
# Values like 1, TRUE, or yes read as disabled. Restart the MCP server to apply.

# Multi-vector L0/L1/L2 retrieval
# RECALLNEST_MULTI_VECTOR=true

# KG triple extraction + graph traversal
# RECALLNEST_KG_MODE=true

# Emotion detection + salience-weighted Weibull decay + arousal boost
# RECALLNEST_EMOTION_SCORING=true

# Multi-source candidate expansion + source-map grounded reconstruction
# (resume default, search opt-in)
# RECALLNEST_CONSTRUCTIVE_RETRIEVAL=true

# Autobiographical narrative metadata layer
# (life-period / general-event / specific-event)
# RECALLNEST_NARRATIVE_MODE=true

# Heuristic-predicted prospective reminders (zero LLM, behavioral signals)
# RECALLNEST_PREDICTIVE_MEMORY=true
